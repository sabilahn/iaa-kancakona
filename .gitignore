# ==============================================================================
# Security & Critical Sensitive Data (MUST NEVER BE COMMITTED)
# ==============================================================================
# Sensitive Credentials & Environment Configs (STANDAR_SECURITY_ENV.md)
# application/config/database.php hanya berisi loader (tanpa kredensial) -> boleh di-commit
.env
.env.*
.env.php
.env_config/
!.env.php.example
!.env.example

# Email credentials & sensitive configs
application/config/email.php
application/config/*/email.php

# Private keys, certificates, and authentication tokens
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.pub
id_rsa*
id_ed25519*
.well-known/

# Database dumps, backups, and exports (Prevents data leakage)
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
*.old
*.save
*.orig
*~

# ==============================================================================
# Logs & Error Dumps (Contains internal paths, SQL queries, session info)
# ==============================================================================
error_log
*/error_log
*.log
application/logs/*
!application/logs/index.html
!application/logs/.gitkeep

# ==============================================================================
# Cache & Temporary Files & Sessions
# ==============================================================================
application/cache/*
!application/cache/index.html
!application/cache/.gitkeep
sess_*
ci_session*
*.tmp
*.temp

# ==============================================================================
# Server & Hosting Specific Files (cPanel / Local PHP overrides)
# ==============================================================================
.user.ini
php.ini
cgi-bin/

# ==============================================================================
# User Uploads & Media (Dynamic data / Customer files)
# ==============================================================================
uploads/*
!uploads/index.html
!uploads/.gitkeep
assets/uploads/*
!assets/uploads/index.html
!assets/uploads/.gitkeep
temp/
tmp/

# ==============================================================================
# Dependencies (Composer & Node)
# ==============================================================================
/vendor/
composer.phar
composer.lock
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# Operating System Artifacts
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory
.fuse_hidden*

# ==============================================================================
# IDEs and Code Editors
# ==============================================================================
.idea/
.vscode/
/nbproject/
*.sublime-project
*.sublime-workspace
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ==============================================================================
# CodeIgniter 4 Writable & Framework Specific Rules
# ==============================================================================
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/public/assets/uploads/*
!/public/assets/uploads/.gitkeep
/tests/coverage*
/tests/tests/
/tests/results/
/results/
/phpunit
/phpunit.xml
_modules/*
